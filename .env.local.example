# Public site URL used for canonical/OG metadata. No trailing slash.
#
# OPTIONAL. lib/site.ts falls back to https://www.thesausageguy.shop in a
# production build and to http://localhost:3000 in development, so leaving
# this unset is correct on Vercel. Set it only to point a build at some other
# host — a staging domain, say. It used to be required, was never set on
# Vercel, and every canonical tag on the live site pointed at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public base path for the Panglao branch. The page lives at this path.
# Default keeps the brief's target: https://thesausageguy.shop/panglao
NEXT_PUBLIC_PANGLAO_PATH=/panglao

# ---------------------------------------------------------------------------
# Loyverse POS — product catalog, counter prices and stock levels.
#
# SECRET. This token has full access to the POS account: treat it like the
# back-office password. It is NOT prefixed NEXT_PUBLIC_, so Next.js keeps it
# server-side and it never reaches the browser. .env.local is gitignored —
# never commit the real value.
#
# Where to get it:
#   Loyverse Back Office -> Settings -> Access tokens -> Add access token
#
# Used by `npm run sync:loyverse` (writes data/loyverse-catalog.json) and, when
# present at runtime, by the live stock/price overlay in lib/catalog.ts.
# Leave it unset and the site quietly serves the last committed snapshot.
LOYVERSE_ACCESS_TOKEN=

# Optional. Only needed when the Loyverse account has several stores and the
# branch name does not match the store name. The sync prints every store id.
LOYVERSE_STORE_ID=

# ---------------------------------------------------------------------------
# Google Places API — rating, review count and review quotes.
#
# SECRET-ish: a Places key is billable, so treat it like a credential and
# restrict it in Google Cloud (API restriction: Places API (New)).
#
# Where to get it:
#   console.cloud.google.com -> project -> enable "Places API (New)"
#   -> APIs & Services -> Credentials -> Create credentials -> API key
#
# Used only by `npm run sync:reviews`, which writes data/google-reviews.json.
# The site reads that committed file, so this key is NOT needed at runtime and
# does not belong in Vercel.
GOOGLE_PLACES_API_KEY=

# Optional. Pin the listing instead of letting the sync resolve it from the
# branch's mapQuery. The sync prints the id it used.
GOOGLE_PLACE_ID=
